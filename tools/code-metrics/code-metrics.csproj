<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <NoWarn>NU1903;NU1701</NoWarn>
    <AssemblyName>code-metrics</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <!-- tool-only package (no lib); GeneratePathProperty lets us reference its bundled metrics engine portably -->
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis.AnalyzerUtilities">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Microsoft.CodeAnalysis.AnalyzerUtilities.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
