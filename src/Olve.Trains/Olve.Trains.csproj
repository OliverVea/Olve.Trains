<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <PublishSelfContained>true</PublishSelfContained>
        <AssemblyName>On Track To Grow</AssemblyName>
        <UserSecretsId>51374f73-c6cc-486d-a620-dc72d2a4af28</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Properties\appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Duende.IdentityModel" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="NReco.Logging.File" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Olve.Engine3D\Olve.Engine3D.csproj" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="logs\" />
    </ItemGroup>

    <!-- Asset pipeline incremental build integration -->
    <PropertyGroup>
        <AssetPipelineProject>$(MSBuildThisFileDirectory)..\Olve.Trains.AssetPipeline\Olve.Trains.AssetPipeline.csproj</AssetPipelineProject>
        <AssetPipelineS3Cache>$(MSBuildThisFileDirectory)..\Olve.Trains.AssetPipeline\temp\s3-cache\</AssetPipelineS3Cache>
    </PropertyGroup>
    <ItemGroup>
        <_ShaderInputs Include="$(MSBuildThisFileDirectory)resources\shaders\**\*.glsl" />
        <_ShaderInputs Include="$(MSBuildThisFileDirectory)..\Olve.Trains.AssetPipeline\templates\ShaderClass.scriban" />
        <_ShaderOutputs Include="$(MSBuildThisFileDirectory)assets\Shaders\*.cs" />

        <_LayoutInputs Include="$(MSBuildThisFileDirectory)resources\layouts\*.xml" />
        <_LayoutInputs Include="$(MSBuildThisFileDirectory)..\Olve.Trains.AssetPipeline\templates\LayoutClass.scriban" />
        <_LayoutOutputs Include="$(MSBuildThisFileDirectory)assets\Layouts\*.cs" />

        <_S3AssetInputs Include="$(AssetPipelineS3Cache)**\*" />
        <_S3AssetOutputs Include="$(MSBuildThisFileDirectory)assets\Meshes\*" />
        <_S3AssetOutputs Include="$(MSBuildThisFileDirectory)assets\Textures\*" />
        <_S3AssetOutputs Include="$(MSBuildThisFileDirectory)assets\Terrains\*" />
        <_S3AssetOutputs Include="$(MSBuildThisFileDirectory)assets\Fonts\*" />
    </ItemGroup>

    <!-- Step 1: Build the asset pipeline project (skipped when pipeline source unchanged) -->
    <Target Name="_BuildAssetPipeline" BeforeTargets="_RunShaderPipeline;_RunLayoutPipeline;_RunS3Pipeline;_RunShaderPipelineMissing;_RunLayoutPipelineMissing;_RunS3PipelineMissing">
        <Exec Command="dotnet build &quot;$(AssetPipelineProject)&quot; -v:quiet --nologo" />
    </Target>

    <!-- Step 2: Per-asset-type targets (each skipped independently via Inputs/Outputs) -->
    <!-- Each has a fallback target that runs when the output directory is missing -->
    <Target Name="_RunShaderPipeline"
            BeforeTargets="BeforeBuild"
            Inputs="@(_ShaderInputs)"
            Outputs="@(_ShaderOutputs)"
            Condition="'@(_ShaderOutputs)' != ''">
        <Message Importance="high" Text="Asset pipeline: rebuilding shaders" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Shaders" />
    </Target>
    <Target Name="_RunShaderPipelineMissing"
            BeforeTargets="BeforeBuild"
            Condition="!Exists('$(MSBuildThisFileDirectory)assets\Shaders')">
        <Message Importance="high" Text="Asset pipeline: shaders missing, rebuilding" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Shaders" />
    </Target>

    <Target Name="_RunLayoutPipeline"
            BeforeTargets="BeforeBuild"
            Inputs="@(_LayoutInputs)"
            Outputs="@(_LayoutOutputs)"
            Condition="'@(_LayoutOutputs)' != ''">
        <Message Importance="high" Text="Asset pipeline: rebuilding layouts" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Layouts" />
    </Target>
    <Target Name="_RunLayoutPipelineMissing"
            BeforeTargets="BeforeBuild"
            Condition="!Exists('$(MSBuildThisFileDirectory)assets\Layouts')">
        <Message Importance="high" Text="Asset pipeline: layouts missing, rebuilding" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Layouts" />
    </Target>

    <Target Name="_RunS3Pipeline"
            BeforeTargets="BeforeBuild"
            Inputs="@(_S3AssetInputs)"
            Outputs="@(_S3AssetOutputs)"
            Condition="'@(_S3AssetOutputs)' != ''">
        <Message Importance="high" Text="Asset pipeline: rebuilding meshes, textures, terrains, fonts" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Meshes,Textures,Terrains,Fonts" />
    </Target>
    <Target Name="_RunS3PipelineMissing"
            BeforeTargets="BeforeBuild"
            Condition="!Exists('$(MSBuildThisFileDirectory)assets\Meshes') or !Exists('$(MSBuildThisFileDirectory)assets\Textures') or !Exists('$(MSBuildThisFileDirectory)assets\Terrains') or !Exists('$(MSBuildThisFileDirectory)assets\Fonts')">
        <Message Importance="high" Text="Asset pipeline: S3 assets missing, rebuilding" />
        <Exec Command="dotnet run --project &quot;$(AssetPipelineProject)&quot; --no-build -- --targets Meshes,Textures,Terrains,Fonts" />
    </Target>

</Project>
