<?xml version="1.0" encoding="utf-8" ?>
<Box id="Root" Vertical="true" Align="Align.Stretch" Justify="Justify.Center" Width="200">
    <Box Vertical="true" Align="Align.Stretch" BackgroundColor="new Olve.Engine3D.RGBA(0.15f, 0.15f, 0.15f, 0.85f)" BorderRadius="6" Padding="8" Gap="4" MarginRight="4">
        <Text Content='"Time of Day:"' Style="InfoTextMedium" />
        <Slider Id="TimeSlider" MinValue="0" MaxValue="24" Value="5.5f" Step="0.25f" Weight="1" Height="20" />
        <Box Align="Align.Center" Gap="6">
            <Checkbox Id="TimePassingCheckbox" IsChecked="true" Size="16" IndicatorSize="10" />
            <Text Id="TimeScaleLabel" Content='"Speed: 1x"' Style="InfoTextMedium" />
        </Box>
        <Slider Id="TimeScaleSlider" MinValue="1" MaxValue="8" Value="4" Step="1" Weight="1" Height="20" />
        <Box MarginTop="8">
            <Text Content='"Sky Color:"' Style="InfoTextMedium" />
        </Box>
        <Dropdown Id="SkyColorDropdown" Options='new string[] { "Dawn", "Day", "Dusk", "Night", "Sunset" }' Width="184" ButtonHeight="24" OptionHeight="22" />
    </Box>
</Box>
