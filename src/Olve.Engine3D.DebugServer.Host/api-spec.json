{
  "openapi": "3.1.1",
  "info": {
    "title": "Olve.Engine3D.DebugServer.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/run-command": {
      "post": {
        "tags": [
          "Olve.Engine3D.DebugServer.Host"
        ],
        "operationId": "RunCommand",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultProblem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/logs": {
      "post": {
        "tags": [
          "Olve.Engine3D.DebugServer.Host"
        ],
        "operationId": "GetLogs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetLogsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLogsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResultProblem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Olve.Engine3D.DebugServer.Host"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Exception": {
        "type": "object",
        "properties": {
          "targetSite": {
            "$ref": "#/components/schemas/MethodBase"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "data": {
            "type": [
              "null",
              "object"
            ]
          },
          "innerException": {
            "$ref": "#/components/schemas/Exception"
          },
          "helpLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          },
          "hResult": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "stackTrace": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GetLogsRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "logLevel": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "since": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetLogsResponse": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogMessage"
            }
          }
        }
      },
      "IPath": { },
      "LogLevel": {
        "enum": [
          "None",
          "Trace",
          "Debug",
          "Info",
          "Warning",
          "Error",
          "Critical"
        ]
      },
      "LogMessage": {
        "required": [
          "level",
          "message",
          "sourcePath",
          "sourceLine",
          "time",
          "tags"
        ],
        "type": "object",
        "properties": {
          "level": {
            "$ref": "#/components/schemas/LogLevel"
          },
          "message": {
            "type": "string"
          },
          "sourcePath": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IPath"
              }
            ]
          },
          "sourceLine": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MethodBase": { },
      "ProblemOriginInformation": {
        "type": "object",
        "properties": {
          "filePath": {
            "$ref": "#/components/schemas/IPath"
          },
          "lineNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "linkString": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ResultProblem": {
        "type": "object",
        "properties": {
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "args": {
            "type": [
              "null",
              "array"
            ]
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          },
          "exception": {
            "$ref": "#/components/schemas/Exception"
          },
          "originInformation": {
            "$ref": "#/components/schemas/ProblemOriginInformation"
          }
        }
      },
      "RunCommandRequest": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "times": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Olve.Engine3D.DebugServer.Host"
    }
  ]
}