    private static string GetModelMeshPath(ModelMeshPath modelMeshPath)
    {
        // var assemblyPath = Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location);
        var filePath = $"assets/meshes/{modelMeshPath.MeshPath}";

