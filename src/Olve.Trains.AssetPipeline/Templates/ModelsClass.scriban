    public static Result<Mesh> LoadModelMesh(ModelMeshPath modelMeshPath)
    {
        var meshPath = GetModelMeshPath(modelMeshPath);

        if (!File.Exists(meshPath))
        {
            return new ResultProblem("Attempted to load mesh '{0}' at non-existent path '{1}'", modelMeshPath.Name,
                meshPath);
        }

        var bytes = File.ReadAllBytes(meshPath);

        try
        {
            var mesh = MemoryPackSerializer.Deserialize<Mesh>(bytes);
            if (mesh is null)
            {
                return new ResultProblem("Could not read mesh file");
            }

            return mesh;
        }
        catch (Exception e)
        {
            return new ResultProblem(e, "Got unexpected error while reading mesh file '{0}': ", meshPath);
        }
    }

